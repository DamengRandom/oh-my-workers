{
  "name": "oh-my-workers",
  "version": "1.2.0",
  "description": "A personal AI agent that automates daily working tasks at workplace, eg: Cronjobs, KPI reporting and etc",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "setup": "pnpm run dev --setup",
    "start": "pnpm run dev --job=daily-kpi",
    "cleanup": "pnpm run dev --job=cleanup",
    "tsc": "pnpm exec tsc --noEmit 2>&1",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "news": "pnpm run dev --job=news",
    "jobs": "pnpm run dev --list-jobs",
    "seed-mock": "node --loader ts-node/esm src/scripts/seed-mock-users.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test:coverage": "c8 --reporter=json --reporter=text --src src --all node --import tsx --test \"src/**/*.test.ts\""
  },
  "keywords": [
    "oh-my-workers",
    "kpi",
    "daily work diary",
    "workplace automation",
    "AI assistant",
    "daily kpi reporting",
    "cronjobs",
    "automation",
    "AI agent",
    "langchain",
    "langsmith",
    "Nvidia",
    "nemotron",
    "typescript",
    "neon",
    "postgresql",
    "personal assistant",
    "news search"
  ],
  "author": "damengrandom",
  "license": "ISC",
  "packageManager": "pnpm@10.7.1",
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.3.1",
    "langchain": "^1.2.37",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "c8": "^12.0.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  }
}
