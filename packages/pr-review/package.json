{
  "name": "@damengrandom/pr-review",
  "version": "0.2.1",
  "description": "AI code-review CLI: reviews a GitHub pull request for bugs, security and performance, using a local clone for surrounding-code context.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "omw-review": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --loader ts-node/esm src/cli.ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "code-review",
    "pull-request",
    "github",
    "ai",
    "llm",
    "claude",
    "langchain",
    "cli",
    "typescript"
  ],
  "author": "damengrandom",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.25",
    "@langchain/core": "^1.1.36",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.3.1",
    "langchain": "^1.2.37",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
